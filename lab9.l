/*
9. Write a validation system in Yacc to check if a regular infix expressions 
mathematical notation is correctly formulated (e.g., a + b * c is valid, 
but a ++ b is rejected).

flex -o q9lex.c q9.l
bison -y -d -o q9yacc.c q9.y
gcc q9lex.c q9yacc.c -o q9
./q9
*/

%{
#include "q9yacc.h"  // Matches the output filename generated by bison -y -d -o q9yacc.c
%}

%%

[0-9]+(\.[0-9]+)?           { return NUM; }       // Matches integers and decimals (e.g., 10, 3.14)
[a-zA-Z_][a-zA-Z0-9_]*      { return ID; }        // Matches variables (e.g., a, b, x1)
[+\-*/()]                   { return yytext[0]; } // Returns operator/bracket ASCII directly to Yacc
\n                          { return '\n'; }      // Signals end of expression
[ \t]+                      ;                     // Ignores spaces and tabs
.                           { return yytext[0]; } // Passes invalid characters to trigger syntax error

%%

int yywrap(void) {
    return 1;
}
